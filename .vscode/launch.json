{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug xserver (Single Server - Local)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/xserver",
            "env": {
                "XSERVER_ADDR": ":8001"
            },
            "args": [],
            "showLog": false
        },
        {
            "name": "Debug yserver",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/yserver",
            "env": {
                "YSERVER_ADDR": ":8002"
            },
            "args": [],
            "showLog": false
        },
        {
            "name": "Debug xserver (Two Servers - Remote)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/xserver",
            "env": {
                "XSERVER_ADDR": ":8001",
                "MODULEY_MODE": "remote",
                "MODULEY_URL": "http://localhost:8002"
            },
            "args": [],
            "showLog": false
        }
    ],
    "compounds": [
        {
            "name": "Debug Both Servers (Two Server Scenario)",
            "configurations": [
                "Debug yserver",
                "Debug xserver (Two Servers - Remote)"
            ],
            "preLaunchTask": "",
            "stopAll": true
        }
    ]
}